<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme - unified accent for switches & radio buttons -->
    <style name="Base.Theme.PouchStream" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryVariant">@color/brand_primary_dark</item>
        <item name="colorOnPrimary">@color/brand_on_primary</item>
        <item name="colorSecondary">@color/brand_primary</item>
        <item name="colorSecondaryVariant">@color/brand_primary_dark</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorControlActivated">@color/brand_primary</item>
        <item name="colorControlHighlight">@color/brand_ripple</item>
        <!-- Ensure AlertDialog radio buttons use same accent -->
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.PouchStream.MaterialAlertDialog</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.PouchStream.AlertDialog</item>
    </style>

    <style name="Theme.PouchStream" parent="Base.Theme.PouchStream" />

    <!-- AlertDialog themes to unify radio button & switch accent -->
    <style name="ThemeOverlay.PouchStream.MaterialAlertDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorSecondary">@color/brand_primary</item>
        <item name="colorControlActivated">@color/brand_primary</item>
    </style>

    <style name="ThemeOverlay.PouchStream.AlertDialog" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorSecondary">@color/brand_primary</item>
        <item name="colorControlActivated">@color/brand_primary</item>
    </style>
</resources>